{
  "name": "praetor-gui-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "screenshots:graphics": "go run ../testdata/render-doc-graphics --output artifacts/ui-screenshots/graphics",
    "screenshots:calculator": "go run ../testdata/render-doc-calculator --output artifacts/ui-screenshots/rbcalc.json",
    "screenshots:fixtures": "npm run screenshots:graphics && npm run screenshots:calculator",
    "e2e": "npm run screenshots:fixtures && tsc --noEmit -p e2e && playwright test",
    "screenshots": "npm run screenshots:fixtures && tsc --noEmit -p e2e && playwright test e2e/docs-screenshots.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.13.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
